{
  "name": "devin-bug-smasher",
  "version": "0.0.0",
  "private": true,
  "description": "Bug Smasher foundation scaffold: a Node.js service that serves a React frontend.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "setup": "node src/operator/main.ts setup",
    "env-status": "node src/operator/main.ts env-status",
    "mirror": "node src/operator/main.ts mirror",
    "report": "node src/operator/main.ts report",
    "replay": "node src/operator/main.ts replay",
    "verify-check": "node src/operator/main.ts verify-check",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "results": "node --env-file-if-exists=.env scripts/results/freeze.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
