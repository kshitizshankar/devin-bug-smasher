# Copy to .env and fill in for live mode. Never commit real values.
# Only the five live settings are required for live mode; everything else shows its default.

GITHUB_REPO=owner/repo
GITHUB_TOKEN=<github-token>
DEVIN_API_KEY=<devin-api-key>
DEVIN_ORG_ID=<devin-org-id>
# Must contain {files} (the regression test files) and {results} (where the runner writes JUnit XML).
# Only this command runs; see docs/VERIFICATION.md.
CHECK_COMMAND=node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination={results} {files}
# The target repository's test image; verification stays unavailable until set.
VERIFY_IMAGE=
# VERIFY_SETUP_COMMAND=npm ci
# VERIFY_TIMEOUT_SECONDS=600
# VERIFY_WORK_DIR=

TRIAGE_LABEL=needs-triage
FIX_LABEL=bug-smasher
ENGINEER_LABEL=needs-engineer
FEATURE_LABEL=devin-builds-feature

# person | rule | auto (see docs/ORCHESTRATION.md "Decision and merge policies")
DECISION=person
# Comma-separated class labels the Rule decision may fix; empty means every bug waits for a person.
DECISION_RULE_CLASSES=
MERGE=person
MERGE_MAX_LINES=200

MAX_ACTIVE_SESSIONS=3
MAX_ACU_PER_SESSION=5
MAX_FIX_RETRIES=1
DEVIN_REVIEW=true
POLL_SECONDS=60

HOST=127.0.0.1
PORT=8080

# Offline replay (used when GITHUB_TOKEN and DEVIN_API_KEY are both unset); see docs/REPLAY.md.
# REPLAY_DIR=data/replay
# Docker Compose only; see docs/DOCKER.md. VERIFY_WORK_DIR above must be an absolute host path there.
# BUG_SMASHER_PORT=8080

# Optional; leave unset when unknown (unknown is never treated as zero).
# BASELINE_FILTER=
# DEVIN_ACU_PRICE_USD=
# DEVIN_SPEND_USD=
# DEVIN_SPEND_READ_AT=2026-01-01T00:00:00Z
# DEVIN_BUDGET_USD=
